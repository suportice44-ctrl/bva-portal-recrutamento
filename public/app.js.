
document.addEventListener("DOMContentLoaded", () => {
  const form = document.getElementById("applicationForm");
  if (!form) return;

  const message = document.getElementById("formMessage");
  const steps = Array.from(
    form.querySelectorAll(".form-step, [data-step]")
  );

  const nextButtons = form.querySelectorAll(
    "[data-next], .next-step"
  );
  const prevButtons = form.querySelectorAll(
    "[data-prev], .prev-step"
  );

  let currentStep = 0;
  let submitting = false;

  function showMessage(text, type) {
    if (!message) return;
    message.textContent = text;
    message.className = "form-message " + type;
    message.style.display = "block";
  }

  function showStep(index) {
    if (!steps.length) return;

    currentStep = Math.max(0, Math.min(index, steps.length - 1));

    steps.forEach((step, i) => {
      step.hidden = i !== currentStep;
      step.style.display = i === currentStep ? "" : "none";
      step.classList.toggle("active", i === currentStep);
    });

    document.querySelectorAll(
      "[data-step-indicator], .step-indicator"
    ).forEach((indicator, i) => {
      indicator.classList.toggle("active", i === currentStep);
      indicator.classList.toggle("completed", i < currentStep);
    });

    const progress = document.querySelector(
      "[data-progress], .progress-bar"
    );

    if (progress) {
      progress.style.width =
        ((currentStep + 1) / steps.length) * 100 + "%";
    }

    if (message) message.style.display = "none";

    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function validateStep(index) {
    const fields = steps[index].querySelectorAll(
      "input, select, textarea"
    );

    for (const field of fields) {
      if (field.disabled || field.type === "hidden") continue;

      if (!field.checkValidity()) {
        field.reportValidity();
        field.focus();
        return false;
      }
    }

    return true;
  }

  nextButtons.forEach(button => {
    button.addEventListener("click", event => {
      event.preventDefault();

      if (!validateStep(currentStep)) return;

      if (currentStep < steps.length - 1) {
        showStep(currentStep + 1);
      }
    });
  });

  prevButtons.forEach(button => {
    button.addEventListener("click", event => {
      event.preventDefault();

      if (currentStep > 0) {
        showStep(currentStep - 1);
      }
    });
  });

  function validateAllSteps() {
    for (let i = 0; i < steps.length; i++) {
      if (!validateStep(i)) {
        showStep(i);
        return false;
      }
    }

    return true;
  }

  form.addEventListener("submit", async event => {
    event.preventDefault();

    if (submitting) return;

    if (!validateAllSteps()) return;

    submitting = true;

    const submitButton = form.querySelector(
      'button[type="submit"], input[type="submit"]'
    );

    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = "A enviar candidatura...";
    }

    showMessage("A enviar a tua candidatura...", "info");

    try {
      const formData = new FormData(form);
      const data = {};

      formData.forEach((value, key) => {
        if (data[key] !== undefined) {
          if (!Array.isArray(data[key])) {
            data[key] = [data[key]];
          }
          data[key].push(value);
        } else {
          data[key] = value;
        }
      });

      const areas = form.querySelectorAll(
        'input[name="areas_atividade"]:checked'
      );

      data.areas_atividade = Array.from(areas)
        .map(input => input.value)
        .join(", ");

      const response = await fetch("/api/candidaturas", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify(data)
      });

      const result = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(
          result.error ||
          result.message ||
          "Não foi possível enviar a candidatura."
        );
      }

      form.reset();

      steps.forEach(step => {
        step.hidden = false;
        step.style.display = "";
      });

      showStep(0);

      form.style.display = "none";

      showMessage(
        "Candidatura enviada com sucesso! A equipa de recrutamento irá analisar os teus dados. Obrigado pelo teu interesse nos Bombeiros Voluntários do Algarve.",
        "success"
      );

    } catch (error) {
      showMessage(
        error.message || "Ocorreu um erro ao enviar a candidatura. Tenta novamente.",
        "error"
      );
    } finally {
      submitting = false;

      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = "Enviar candidatura";
      }
    }
  });

  if (steps.length) {
    showStep(0);
  }
});
